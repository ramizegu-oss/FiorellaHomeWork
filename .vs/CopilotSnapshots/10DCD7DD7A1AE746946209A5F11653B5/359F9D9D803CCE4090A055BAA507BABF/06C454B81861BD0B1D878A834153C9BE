<style>
    .live-search-input-row {
        position: relative;
    }

    header nav ul .search .live-search-results {
        position: absolute;
        top: calc(100% + 10px);
        left: 0;
        z-index: 1000;
        display: block;
        width: 320px;
        max-height: 330px;
        overflow-y: auto;
        padding: 6px 0;
        margin: 0;
        background: #fff;
        border-radius: 4px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, .14);
        opacity: 1;
        visibility: visible;
    }

    header nav ul .search .live-search-results[hidden] {
        display: none !important;
    }

    header nav ul .search .live-search-result {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 10px 14px;
        color: #1b1b1b !important;
        text-decoration: none;
        text-transform: none;
        letter-spacing: normal;
        transition: background-color .2s ease;
    }

    header nav ul .search .live-search-result::after {
        display: none;
    }

    header nav ul .search .live-search-result:hover {
        background-color: #f7f7f7;
        color: #1b1b1b !important;
        text-decoration: none;
    }

    .live-search-result img {
        flex: 0 0 56px;
        width: 56px;
        height: 56px;
        object-fit: cover;
    }

    .live-search-product-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }

    .live-search-product-name {
        font-size: 14px;
        font-weight: 600;
    }

    .live-search-product-price {
        color: #888;
        font-size: 13px;
    }

    .live-search-empty {
        padding: 12px 14px;
        color: #888;
        font-size: 13px;
    }

    @media (max-width: 575.98px) {
        header nav ul .search .live-search-results {
            width: min(320px, calc(100vw - 40px));
        }
    }
</style>

<li class="nav-item my-auto search">
    <i class="fas fa-search" aria-hidden="true"></i>
    <ul class="list-unstyled py-3">
        <li class="d-flex px-3 live-search-input-row">
            <input id="input-search"
                   type="search"
                   placeholder="Search"
                   autocomplete="off"
                   aria-label="Search products"
                   aria-controls="search-results">
            <i class="fas fa-search my-auto" aria-hidden="true"></i>
            <div id="search-results"
                 class="live-search-results"
                 role="listbox"
                 aria-label="Search results"
                 hidden>
            </div>
        </li>
    </ul>
</li>

<script>
    (() => {
        const searchArea = document.querySelector(".search");
        const input = document.getElementById("input-search");
        const results = document.getElementById("search-results");
        const searchUrl = "@Url.Action("Search", "Home")";
        let timer;
        let requestController;

        if (!searchArea || !input || !results) {
            return;
        }

        input.addEventListener("input", () => {
            clearTimeout(timer);
            requestController?.abort();

            const query = input.value.trim();
            if (!query) {
                results.replaceChildren();
                results.hidden = true;
                return;
            }

            results.hidden = true;
            timer = setTimeout(async () => {
                requestController = new AbortController();
                const url = new URL(searchUrl, window.location.origin);
                url.searchParams.set("txt", query);

                try {
                    const response = await fetch(url, { signal: requestController.signal });
                    if (!response.ok) {
                        throw new Error(`Search failed: ${response.status}`);
                    }

                    const html = await response.text();
                    if (input.value.trim() !== query) {
                        return;
                    }

                    results.innerHTML = html;
                    results.hidden = false;
                } catch (error) {
                    if (error.name !== "AbortError") {
                        console.error("Could not load search results:", error);
                    }
                }
            }, 250);
        });

        document.addEventListener("click", event => {
            if (!searchArea.contains(event.target)) {
                results.hidden = true;
            }
        });

        input.addEventListener("keydown", event => {
            if (event.key === "Escape") {
                results.hidden = true;
            }
        });
    })();
</script>
